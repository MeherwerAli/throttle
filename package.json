{
  "name": "@meherwer_ali/throttle",
  "version": "0.1.0",
  "description": "Express admission control with explicit distributed failure semantics.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeherwerAli/throttle.git"
  },
  "homepage": "https://github.com/MeherwerAli/throttle#readme",
  "bugs": {
    "url": "https://github.com/MeherwerAli/throttle/issues"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./redis": {
      "types": "./dist/redis.d.ts",
      "import": "./dist/redis.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:redis": "vitest run test/integration/redis.test.ts",
    "test:consumer": "node scripts/verify-consumer.mjs",
    "pack:check": "npm pack --dry-run",
    "verify": "npm run check && npm run test && npm run build && npm run pack:check"
  },
  "peerDependencies": {
    "express": ">=4.18 <6",
    "redis": ">=6 <7"
  },
  "peerDependenciesMeta": {
    "redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "express": "^5.2.1",
    "redis": "^6.2.1",
    "supertest": "^7.1.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "keywords": [
    "express",
    "rate-limit",
    "redis",
    "token-bucket",
    "sliding-window"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
